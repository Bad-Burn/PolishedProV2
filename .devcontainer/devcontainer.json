{
  "name": "PolishedPro presentation",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/PolishedProV2",
  "remoteUser": "vscode",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "PolishedPro",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postStartCommand": "bash .devcontainer/start-presentation.sh"
}
