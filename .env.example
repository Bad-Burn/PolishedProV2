# ---------------------------------------------------------------------------
# PolishedPro environment
# Copy this file to `.env` and fill it in. Never commit the real .env.
# Anything after " #" is a comment — put a value that contains "#" (a password,
# say) in quotes: DB_PASSWORD="abc#123".
# ---------------------------------------------------------------------------

APP_NAME=PolishedPro
APP_ENV=local                 # local | production
APP_DEBUG=true                # MUST be false in production
APP_TIMEZONE=Asia/Manila

# Generate with:  php bin/key.php
APP_KEY=

# Absolute URL of the site. Required for PayPal return links and webhooks.
# Local XAMPP PHP server: php -S 127.0.0.1:8765 -t public bin/router.php
APP_URL=http://127.0.0.1:8765

# Set only if auto-detection of the subdirectory fails.
# APP_BASE_PATH=/polishedpro-v2/public

# Enable only while using a trusted reverse proxy. Forwarded headers are honored
# only when REMOTE_ADDR matches one of these proxy IPs. Ngrok running on this
# same machine normally connects to loopback; add a proxy IP only when verified.
TRUSTED_PROXY=false
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Shown on error pages and in every email. Use an inbox someone actually reads.
SUPPORT_EMAIL=support@polishedpro.test

# ---------------------------------------------------------------------------
# Email
# log  = write messages to storage/logs/mail.log (local development only)
# smtp = send for real. Any SMTP provider works: Brevo, Postmark, Amazon SES,
#        Mailgun, Google Workspace. Without it, password reset, booking
#        notices and reminders never reach anyone.
# ---------------------------------------------------------------------------
MAIL_DRIVER=log               # log | smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls           # tls (STARTTLS, 587) | ssl (465) | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@polishedpro.test
MAIL_FROM_NAME=PolishedPro

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=polishedpro_v2
DB_USER=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Security tuning
# ---------------------------------------------------------------------------
SESSION_IDLE_TIMEOUT=3600     # seconds of inactivity before sign-out
SESSION_ABSOLUTE_TIMEOUT=43200
REMEMBER_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------
BOOKING_MIN_LEAD_MINUTES=120
BOOKING_MAX_ADVANCE_DAYS=60
BOOKING_MAX_UPCOMING_PER_CLIENT=5   # pending + confirmed bookings one client may hold

# ---------------------------------------------------------------------------
# PayPal Subscriptions (free sandbox at developer.paypal.com)
# Leave blank to use offline/manual plan activation instead.
# ---------------------------------------------------------------------------
PAYPAL_MODE=sandbox           # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=PHP
PAYPAL_PRODUCT_ID=
PAYPAL_PLAN_ID=
PAYPAL_MONTHLY_PRICE=149.00
PAYPAL_YEARLY_PRICE=1490.00
