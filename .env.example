# ---------------------------------------------------------------------------
# PolishedPro environment
# Copy this file to `.env` and fill it in. Never commit the real .env.
# ---------------------------------------------------------------------------

APP_NAME=PolishedPro
APP_ENV=local                 # local | production
APP_DEBUG=true                # MUST be false in production
APP_TIMEZONE=Asia/Manila

# Generate with:  php bin/key.php
APP_KEY=

# Absolute URL of the site. Required for PayPal return links and webhooks.
# XAMPP example:  http://localhost/polishedpro-v2/public
APP_URL=http://localhost/polishedpro-v2/public

# Set only if auto-detection of the subdirectory fails.
# APP_BASE_PATH=/polishedpro-v2/public

# Enable ONLY when running behind a load balancer / Cloudflare you control.
TRUSTED_PROXY=false

SUPPORT_EMAIL=support@polishedpro.test

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_DRIVER=mysql               # mysql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=polishedpro_v2
DB_USER=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Security tuning
# ---------------------------------------------------------------------------
SESSION_IDLE_TIMEOUT=3600     # seconds of inactivity before sign-out
SESSION_ABSOLUTE_TIMEOUT=43200
REMEMBER_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------
BOOKING_MIN_LEAD_MINUTES=120
BOOKING_MAX_ADVANCE_DAYS=60

# ---------------------------------------------------------------------------
# PayPal Subscriptions (free sandbox at developer.paypal.com)
# Leave blank to use offline/manual plan activation instead.
# ---------------------------------------------------------------------------
PAYPAL_MODE=sandbox           # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=PHP
