# Normalise to LF in the repository. Windows checkouts still get CRLF locally,
# but nobody sees a whole-file diff just because they opened it on a different
# machine. Set before the first commit so there is no churn to undo later.
* text=auto eol=lf

# Binary: never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Keep .htaccess as LF — Apache is fussy about stray carriage returns.
.htaccess text eol=lf
