# PolishedPro — public document root

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Send everything that is not a real file or directory to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve a directory index.
Options -Indexes -MultiViews

# Deny access to dotfiles that may end up here by accident.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Cache static assets aggressively — URLs are versioned with ?v=mtime.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css            "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml       "access plus 1 year"
    ExpiresByType image/webp          "access plus 6 months"
    ExpiresByType image/jpeg          "access plus 6 months"
    ExpiresByType image/png           "access plus 6 months"
    ExpiresByType font/woff2          "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Do not advertise the PHP version.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

php_flag expose_php off
