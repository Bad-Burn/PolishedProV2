# User-uploaded files: serve as inert static content only.
#
# Uploads are re-encoded through GD before they land here, but this is the
# belt-and-braces layer: even if a script somehow reached this directory the
# server must never execute it.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Strip every handler that could execute a file here.
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .jsp .asp .shtml .sh
RemoveType    .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .jsp .asp .shtml .sh

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'; sandbox"
</IfModule>

# Only allow the image types the uploader produces.
<FilesMatch "\.(?!(jpe?g|png|webp|gif)$)[^.]+$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
